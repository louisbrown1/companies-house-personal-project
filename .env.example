CH_MCP_MODE=http
CH_MCP_URL=http://localhost:8081/mcp
CH_MCP_AUTH=
COMPANIES_HOUSE_API_KEY=
AGENT_UI_TOKEN=
DATABASE_URL=sqlite:///./underwriting.db
REPORT_TIMEOUT_SEC=600
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
MODEL_PROVIDER=gemini
# To test a self-hosted Gemma model, set MODEL_PROVIDER=gemma.
GEMMA_API_BASE=http://127.0.0.1:9379/v1
GEMMA_MODEL=gemma4-12b
GEMMA_API_KEY=
# Optional ephemeral context across financial table batches and OCR retries.
DOCUMENT_MEMORY_ENABLED=0


# Tavily web search API key
TAVILY_API_KEY=
# Shared report budget covers background, reviews, Pillar 3 and peer research.
SEARCH_MAX_REQUESTS_PER_REPORT=40
SEARCH_MAX_EXTRACT_REQUESTS_PER_REPORT=12
# Successful Tavily responses only. 0 disables caching; extracts capped at 900s.
SEARCH_CACHE_TTL_SECONDS=3600
BROWSER_RESEARCH_ENABLED=0
BROWSER_RESEARCH_CHANNEL=msedge
BROWSER_RESEARCH_SEARCH_ENGINE=bing
BROWSER_RESEARCH_MAX_RUNS=2
BROWSER_RESEARCH_MAX_STEPS=6
BROWSER_RESEARCH_TIMEOUT_SEC=120
# Google grounding is not a reusable/cached discovery source under its current terms.

# Optional: up to two comma-separated peer CRNs; blank enables Tavily/Gemma peer discovery.
# Registry identity, SIC, accounts and calculation validation still apply.
PEER_COMPANY_NUMBERS=
